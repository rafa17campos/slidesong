# Copy to worker.env next to start-worker.bat on the GPU machine.
# Slidesong's token (the same as in its secrets.env)
WORKER_TOKEN=change-me-same-as-the-app
# Other apps that use this worker, each with its own token (revocable on its own)
# WORKER_TOKENS=photo-library:change-me
# A read-only Immich API key for the worker itself (asset read/view/download, face read): it fetches photos and faces
# inside the home network, so clients only send asset ids. Without it, photos come through Slidesong.
IMMICH_URL=http://immich-host:2283
IMMICH_API_KEY=change-me
# video_mode=deep keeps the frames of recent videos here (WORKER_DIR) for the next job; this caps them (MB)
# WORKER_FRAME_CACHE_MB=2048
SLIDESONG_IMAGES_URL=http://slidesong-host:8096
SLIDESONG_VCODEC=h264_nvenc
WHISPER_DEVICE=cuda
WORKER_DIR=C:\\slidesong-worker\\work
SLIDESONG_DATA=C:\\slidesong-worker\\data
HF_HOME=C:\\slidesong-worker\\hf
TORCH_HOME=C:\\slidesong-worker\\torch
