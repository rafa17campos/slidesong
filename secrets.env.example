# Copy to secrets.env (chmod 600). Read by docker compose (env_file) and by the dev server.

# ---- Immich (required) ----
IMMICH_URL=http://127.0.0.1:2283
# An API key of your Immich user with read permissions only: asset.read, asset.view, asset.download,
# album.read, person.read, face.read
IMMICH_API_KEY=change-me
# Immich's machine-learning service (text embeddings for matching lyrics with photos)
IMMICH_ML_URLS=http://127.0.0.1:3003
# Where people open Immich in the browser (the «Open Immich» links)
IMMICH_WEB_URL=https://photos.example.com
# Optional, better suggestions: a Postgres role that can only read the CLIP vectors (see README)
# IMMICH_VEC_DSN=postgresql://slidesong_ro:password@127.0.0.1:5432/immich

# ---- Optional: Claude reads the lyrics (translation, what photo fits each line, month and season) ----
# Only the lyrics, the song title and the names of the people you chose are sent; never photos.
# Without a key, a local translator is used if installed (see README).
ANTHROPIC_API_KEY=
# SLIDESONG_LYRICS_MODEL=claude-sonnet-5-5

# ---- Optional: GPU worker (see README) ----
# SLIDESONG_WORKER_URL=http://gpu-host:8097
# WORKER_TOKEN=change-me
# SLIDESONG_WORKER_NAME=GPU computer

# ---- Optional: photo analysis kept by another service (see slidesong/insights.py) ----
# SLIDESONG_INSIGHTS_URL=https://photo-library.example.com
# SLIDESONG_INSIGHTS_TOKEN=change-me

# ---- Optional: network ----
# Host names this app answers to (protects against DNS rebinding); unset = any.
# SLIDESONG_ALLOWED_HOSTS=slidesong.example.com,localhost,127.0.0.1
# Old host names that send people to the new one, same path (after renaming the domain):
# SLIDESONG_HOST_REDIRECTS=old.example.com=slidesong.example.com

# ---- Optional: «Copy reference for Claude» (project menu, photo details) ----
# A short text to paste into a chat with an assistant (e.g. Claude Code) that can read this app's data folder.
# SLIDESONG_ASSISTANT_REFERENCES=1

# ---- If you run a modified Slidesong for other people: where its source code is (AGPL-3.0) ----
# SLIDESONG_SOURCE_URL=https://github.com/you/slidesong
